// Secrets.example.xcconfig — copy to Secrets.xcconfig (gitignored) and fill in.
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// The anon (publishable) key is safe to ship in a client binary; it is gated by
// Supabase row-level security. Never put the service-role key here.
//
// NOTE: xcconfig treats `//` as a comment everywhere, which breaks `https://`.
// Work around it by splitting the scheme out and recombining at runtime, OR set
// SUPABASE_URL without the slashes and add them back. Simplest: store the host and
// build the URL in SupabaseConfig. Here we store the full URL using the xcconfig
// slash-escape trick: write the two slashes as ${SLASH}${SLASH} is overkill — instead
// we store the bare host in SUPABASE_HOST and prepend https:// in code.

SUPABASE_HOST = YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY

// Optional: Apple Developer Team ID for signing on a real device.
// DEVELOPMENT_TEAM = ABCDE12345
