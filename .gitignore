# ── Secrets (never commit) ──────────────────────────────────────────────
Config/Secrets.xcconfig
# QA account for the XCUITest suite, mirroring the webapp's file and variable
# names (DEVTOOLS_TEST_EMAIL / DEVTOOLS_TEST_PASSWORD). See
# docs/HARNESS-AND-LOOSE-ENDS.md §2 — the doc says where they live, this file
# holds them, and neither ever carries a value into git.
.env.local
.env*.local

# ── Xcode (project is generated from project.yml via XcodeGen) ───────────
*.xcodeproj
*.xcworkspace
!default.xcworkspace
xcuserdata/
*.xcuserstate
DerivedData/
build/
.build/

# ── Swift Package Manager ───────────────────────────────────────────────
Package.resolved
.swiftpm/

# ── macOS / misc ────────────────────────────────────────────────────────
.DS_Store
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
