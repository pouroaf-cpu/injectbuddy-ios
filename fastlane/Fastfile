default_platform(:ios)

# Constants matching project.yml / XcodeGen output.
PROJECT  = "InjectBuddy.xcodeproj"
SCHEME   = "InjectBuddy"
BUNDLE_ID = "com.injectbuddy.ios"

platform :ios do
  # Generate the Xcode project from project.yml (it is never checked in).
  # Requires `brew install xcodegen` and a populated Config/Secrets.xcconfig,
  # both of which the GitHub Actions workflow takes care of before calling a lane.
  def regenerate_project
    sh("cd .. && xcodegen generate")
  end

  # Build an App Store Connect API key token from ENV (key auth, no Apple ID password).
  # ASC_KEY_P8 is the base64-encoded contents of the AuthKey_XXXX.p8 file.
  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Run the unit tests (CalculatorEngine golden tests + calendar projection)"
  lane :tests do
    regenerate_project
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      destination: "generic/platform=iOS Simulator",
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
  end

  desc "Build a signed archive and upload it to TestFlight"
  lane :beta do
    regenerate_project

    api_key = asc_api_key

    # Build number: prefer the latest build already on TestFlight (+1), and never
    # go below the GitHub Actions run number so re-runs always move forward.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      initial_build_number: 0
    ) rescue 0
    run_number = (ENV["GITHUB_RUN_NUMBER"] || "0").to_i
    next_build = [latest + 1, run_number].max

    increment_build_number(
      build_number: next_build,
      xcodeproj: PROJECT
    )

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: "app-store",
      # Automatic signing managed by Xcode + the ASC API key; supply the team id.
      xcargs: [
        "-allowProvisioningUpdates",
        "DEVELOPMENT_TEAM=#{ENV['DEVELOPMENT_TEAM']}",
        "CODE_SIGN_STYLE=Automatic"
      ].join(" ")
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true
    )
  end
end
