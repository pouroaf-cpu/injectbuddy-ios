app_identifier("com.injectbuddy.ios")

# ENV-driven so nothing sensitive is committed. With App Store Connect API key
# auth these are optional, but fastlane reads them when present.
apple_id(ENV["FASTLANE_APPLE_ID"])              # your Apple ID email (optional with API key auth)
team_id(ENV["DEVELOPMENT_TEAM"])                # Apple Developer Team ID
itc_team_id(ENV["ASC_TEAM_ID"])                 # App Store Connect team id (optional)
